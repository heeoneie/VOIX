# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini (Google AI)
GEMINI_API_KEY=your_gemini_api_key
# 선택: 기본값 gemini-3.8-flash
GEMINI_MODEL=

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# 공급사 선택 (선택). 비우면 Gemini(STT·LLM) + ElevenLabs(TTS)
# openai 로 두면 해당 단계를 OpenAI로 처리한다
AI_PROVIDER=
TTS_PROVIDER=

# OpenAI (AI_PROVIDER 또는 TTS_PROVIDER가 openai일 때만 필요)
OPENAI_API_KEY=your_openai_api_key
# 선택: 기본값 gpt-4o-mini-transcribe / gpt-4o-mini / gpt-4o-mini-tts
OPENAI_STT_MODEL=
OPENAI_LLM_MODEL=
OPENAI_TTS_MODEL=
